{
  "name": "cue",
  "productName": "Cue",
  "version": "0.1.0",
  "private": true,
  "description": "Cue: a private real-time meeting copilot overlay (Windows + Zoom + Gemini)",
  "author": "Mithun",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build:app": "electron-vite build",
    "build": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test test/*.test.ts",
    "prep": "tsx src/prep/index.ts"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@tesseract.js-data/eng": "1.0.0",
    "jszip": "3.10.1",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.1",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
